binds {

    Mod+K                              { show-hotkey-overlay; }

    // ─── Applications ───
    Mod+A                               hotkey-overlay-title="Open Terminal: kitty" { spawn "kitty"; }
    Mod+E                               hotkey-overlay-title="Open Password Manager: KeepassXC" { spawn "keepassxc"; }
    Mod+O                               hotkey-overlay-title="Open Devbox" { spawn "distrobox enter --clean-path --no-workdir devbox -- kitty herdr"; }
    Mod+U                               hotkey-overlay-title="Open Browser: zen-browser" { spawn "zen-browser"; }
    Mod+R                               hotkey-overlay-title="Open App Launcher: noctalia launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+C                               hotkey-overlay-title="Session Menu: noctalia sessionMenu" { spawn-sh "noctalia msg panel-toggle session"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "noctalia msg media play"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "noctalia msg media stop"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Movement and Focus ───
    Mod+Q                               { close-window; }

    Mod+H                               { focus-column-left; }
    Mod+S                               { focus-column-right; }
    Mod+Shift+H                         { move-column-left; }
    Mod+Shift+S                         { move-column-right; }

    Mod+CTRL+H                          { focus-monitor-left; }
    Mod+CTRL+S                          { focus-monitor-right; }
    Mod+Shift+CTRL+H                    { move-column-to-monitor-left; }
    Mod+Shift+CTRL+S                    { move-column-to-monitor-right; }

    // ─── Workspace Switching ───
    Mod+T                               { focus-workspace-down; }
    Mod+N                               { focus-workspace-up; }
    Mod+Shift+T                         { move-column-to-workspace-down; }
    Mod+Shift+N                         { move-column-to-workspace-up; }

    // ─── Modes ───
    Mod+M                               { maximize-window-to-edges; }

    // ─── Emergency Escape Key ───
    Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
