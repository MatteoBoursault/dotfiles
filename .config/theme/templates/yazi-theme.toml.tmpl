[mgr]
cwd = { fg = "#${BLUE}" }

hovered         = { fg = "#${BG2}", bg = "#${ACCENT}" }
preview_hovered = { underline = true }

find_keyword  = { fg = "#${YELLOW}", italic = true }
find_position = { fg = "#${MAGENTA}", bg = "reset", italic = true }

marker_copied   = { fg = "#${GREEN}",  bg = "#${GREEN}" }
marker_cut      = { fg = "#${RED}",    bg = "#${RED}" }
marker_marked   = { fg = "#${CYAN}",   bg = "#${CYAN}" }
marker_selected = { fg = "#${YELLOW}", bg = "#${YELLOW}" }

tab_active   = { fg = "#${BG2}", bg = "#${ACCENT}" }
tab_inactive = { fg = "#${FG0}", bg = "#${BG3}" }
tab_width    = 1

count_copied   = { fg = "#${BG2}", bg = "#${GREEN}" }
count_cut      = { fg = "#${BG2}", bg = "#${RED}" }
count_selected = { fg = "#${BG2}", bg = "#${YELLOW}" }

border_symbol = "│"
border_style  = { fg = "#${FG3}" }

[mode]
normal_main = { fg = "#${BG2}",    bg = "#${ACCENT}", bold = true }
normal_alt  = { fg = "#${ACCENT}", bg = "#${BG3}" }

select_main = { fg = "#${BG2}",   bg = "#${GREEN}", bold = true }
select_alt  = { fg = "#${GREEN}", bg = "#${BG3}" }

unset_main  = { fg = "#${BG2}", bg = "#${RED}", bold = true }
unset_alt   = { fg = "#${RED}", bg = "#${BG3}" }

[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "#${BG3}", bg = "#${BG3}" }

progress_label  = { fg = "#${FG0}", bold = true }
progress_normal = { fg = "#${BLUE}", bg = "#${BG3}" }
progress_error  = { fg = "#${RED}",  bg = "#${BG3}" }

permissions_t = { fg = "#${BLUE}" }
permissions_r = { fg = "#${YELLOW}" }
permissions_w = { fg = "#${RED}" }
permissions_x = { fg = "#${GREEN}" }
permissions_s = { fg = "#${FG3}" }

[input]
border   = { fg = "#${ACCENT}" }
title    = {}
value    = {}
selected = { reversed = true }

[pick]
border   = { fg = "#${ACCENT}" }
active   = { fg = "#${PURPLE}" }
inactive = {}

[confirm]
border  = { fg = "#${ACCENT}" }
title   = { fg = "#${ACCENT}" }
content = {}
list    = {}
btn_yes = { reversed = true }
btn_no  = {}

[cmp]
border   = { fg = "#${ACCENT}" }
active   = { fg = "#${PURPLE}" }
inactive = {}

[tasks]
border  = { fg = "#${ACCENT}" }
title   = {}
hovered = { fg = "#${PURPLE}", underline = true }

[which]
mask            = { bg = "#${BG1}" }
cand            = { fg = "#${CYAN}" }
rest            = { fg = "#${FG3}" }
desc            = { fg = "#${PURPLE}" }
separator       = "  "
separator_style = { fg = "#${BG5}" }

[help]
on      = { fg = "#${PURPLE}" }
run     = { fg = "#${CYAN}" }
hovered = { reversed = true, bold = true }
footer  = { fg = "#${BG1}", bg = "#${FG0}" }

[notify]
title_info  = { fg = "#${CYAN}" }
title_warn  = { fg = "#${YELLOW}" }
title_error = { fg = "#${RED}" }

[filetype]
rules = [
  { mime = "image/*",                                        fg = "#${GREEN}" },
  { mime = "{audio,video}/*",                                fg = "#${YELLOW}" },
  { mime = "application/{,g}zip",                            fg = "#${MAGENTA}" },
  { mime = "application/x-{tar,bzip*,7z-compressed,xz,rar}", fg = "#${MAGENTA}" },
  { mime = "application/{pdf,doc,rtf}",                      fg = "#${CYAN}" },
  { name = "*",  fg = "#${FG0}" },
  { name = "*/", fg = "#${BLUE}" },
]
